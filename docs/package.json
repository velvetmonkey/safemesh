    "test": "node --test assurance.test.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.0",
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "pagefind": "^1.5.2",
    "parse5": "8.0.1",
    "rehype-raw": "7.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-smartypants": "3.0.3",
    "unified": "11.0.5"
  }
}
