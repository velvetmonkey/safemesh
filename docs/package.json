{
  "name": "safemesh-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host localhost --port 4321",
    "build": "astro build && node check-assurance.mjs && python3 generate-reference.py && pagefind --site dist",
