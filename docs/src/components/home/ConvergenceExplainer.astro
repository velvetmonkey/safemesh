---
// An illustration of independent additions, not a running SafeMesh integration.
const { labUrl } = Astro.props as { labUrl: string };
const devices = ['A', 'B', 'C'];
---

<div class="sm-mesh-wrap">
<figure class="sm-mesh" data-mesh data-phase="offline" aria-label="Illustration: a field crew shares a checklist">
  <figcaption class="sm-mesh-top">
    <strong>Edited apart. Same checklist together.</strong>
    <span>Field crew · illustration · both edits kept</span>
  </figcaption>
  <div class="sm-story">
    <section class="sm-story-step" data-story-step="offline" aria-label="1. Offline">
      <h2>1. Offline</h2>
      <p>Three copies. The crew adds two checklist entries.</p>
      <div class="sm-devices">
        <div data-device><b>Device A</b><span>✓ Pump checked</span></div>
        <div data-device><b>Device B</b><span>! Valve leaking</span></div>
        <div data-device><b>Device C</b><span>No entries yet</span></div>
      </div>
    </section>
    <section class="sm-story-step" data-story-step="sync" aria-label="2. Reconnect">
      <h2>2. Reconnect</h2>
      <p>The app delivers both entries to every device.</p>
      <div class="sm-exchange">A ↔ B ↔ C <span>Share “Pump checked” + “Valve leaking”</span></div>
    </section>
    <section class="sm-story-step" data-story-step="replay" aria-label="3. Same everywhere">
      <h2>3. Same everywhere</h2>
      <p>All three lists match. Neither addition is lost.</p>
      <div class="sm-devices sm-devices-same">
        {devices.map(device => <div data-device><b>Device {device}</b><span>✓ Pump checked</span><span>! Valve leaking</span></div>)}
      </div>
    </section>
  </div>
  <div class="sm-mesh-controls" role="group" aria-label="Explore the checklist illustration" data-mesh-controls hidden>
    <button type="button" data-phase-button="offline" aria-pressed="true">1. Offline</button>
    <button type="button" data-phase-button="sync" aria-pressed="false">2. Reconnect</button>
    <button type="button" data-phase-button="replay" aria-pressed="false">3. Same everywhere</button>
  </div>
  <button type="button" class="sm-mesh-playback" data-mesh-playback hidden>Pause animation</button>
</figure>
<p class="sm-mesh-foot">
  Illustration of two additions to a shared set, not a running integration.
  Your app supplies delivery and storage. For the real Rust/WASM behavior, <a href={labUrl}>open SafeMesh Lab ↗</a>.
</p>
</div>

<script>
  for (const mesh of document.querySelectorAll<HTMLElement>('[data-mesh]')) {
    const buttons = mesh.querySelectorAll<HTMLButtonElement>('[data-phase-button]');
    const controls = mesh.querySelector<HTMLElement>('[data-mesh-controls]')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const playback = mesh.querySelector<HTMLButtonElement>('[data-mesh-playback]')!;
    const phases = ['offline', 'sync', 'replay'] as const;
    type Phase = typeof phases[number];
    let phase: Phase = 'offline';
    let paused = false;
    let timer: ReturnType<typeof setTimeout> | undefined;

    function render(next: Phase) {
      phase = next;
      mesh.dataset.phase = phase;
      for (const choice of buttons) choice.setAttribute('aria-pressed', String(choice.dataset.phaseButton === phase));
    }
    function schedule() {
      window.clearTimeout(timer);
      // Static HTML is the complete story, including before JS or without JS.
      mesh.dataset.presentation = motion.matches ? 'storyboard' : 'animated';
      controls.hidden = motion.matches;
      playback.hidden = motion.matches;
      const running = !paused && !motion.matches && !document.hidden;
      mesh.dataset.running = String(running);
      playback.textContent = paused ? 'Play animation' : 'Pause animation';
      if (running) timer = window.setTimeout(() => {
        render(phases[(phases.indexOf(phase) + 1) % phases.length]);
        schedule();
      }, 4000);
    }
    for (const button of buttons) {
      button.addEventListener('click', () => {
        paused = true;
        render(button.dataset.phaseButton as Phase);
        schedule();
      });
    }
    playback.addEventListener('click', () => { paused = !paused; schedule(); });
    document.addEventListener('visibilitychange', schedule);
    motion.addEventListener('change', () => { render('offline'); schedule(); });
    schedule();
  }
</script>
