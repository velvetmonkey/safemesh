---
// Task routes: build, understand and connect. Every href is BASE_URL-aware so
// the GitHub Pages `/safemesh/` prefix survives (DESIGN-AND-INTEGRATION.md
// section 3) — a hardcoded root-relative link would lose it.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const cards = [
  {
    number: '01 / BUILD',
    title: 'Count offline events',
    body: 'G-Counter combines each writer’s cumulative tally. Receiving the same state again leaves the count unchanged.',
    href: `${base}/getting-started/`,
  },
  {
    number: '02 / UNDERSTAND',
    title: 'Share set membership',
    body: 'OR-Set tracks adds and observed removes. Learn what happens when devices edit the same member offline.',
    href: `${base}/concepts/`,
  },
  {
    number: '03 / CONNECT',
    title: 'Persist, restart, reconnect',
    body: 'Continue to the Linux durable Rust walkthrough or the TypeScript guide with application-owned storage.',
    href: `${base}/getting-started/`,
  },
];
---

<nav class="sm-path-grid" aria-label="Choose a starting point">
  {cards.map((card) => (
    <a class="sm-path-card" href={card.href}>
      <span class="sm-path-card-title">{card.title}</span>
      <p>{card.body}</p>
    </a>
  ))}
</nav>
