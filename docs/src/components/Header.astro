---
import { releaseStatus } from '../../release-status.mjs';
import Search from '@astrojs/starlight/components/Search.astro';
import ThemeSelect from '@astrojs/starlight/components/ThemeSelect.astro';
const labUrl = import.meta.env.LAB_URL || 'http://localhost:4173/';
const lab = new URL(labUrl);
if (!['http:', 'https:'].includes(lab.protocol)) throw new Error('LAB_URL must use HTTP or HTTPS');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<div class="sm-header">
  <a class="sm-brand" href={import.meta.env.BASE_URL} aria-label="SafeMesh documentation home">
    SafeMesh
  </a>
  <nav class="sm-nav" aria-label="Global">
    <a href={`${base}/getting-started/`}>Guides</a>
    <a href={`${base}/reference/`}>API</a>
    <a href={lab.href}>Lab</a>
    <a href="https://github.com/velvetmonkey/safemesh">GitHub</a>
    <a class="sm-release" href="https://github.com/velvetmonkey/safemesh/releases">{releaseStatus}</a>
  </nav>
  <div class="sm-tools"><Search /><ThemeSelect /></div>
</div>
<style>
  .sm-header, .sm-nav, .sm-tools { display: flex; align-items: center; gap: 1rem; }
  .sm-header { justify-content: space-between; height: 100%; }
  .sm-brand {
    display: flex;
    gap: .5rem;
    align-items: center;
    color: var(--sl-color-white);
    font-size: 1.05rem;
    font-weight: 750;
    letter-spacing: -.03em;
    text-decoration: none;
    white-space: nowrap;
  }
  .sm-brand-mark { width: 1.5rem; height: 1.5rem; color: var(--sm-accent); flex-shrink: 0; }
  .sm-brand small {
    border-left: 1px solid var(--sl-color-hairline);
    padding-left: .65rem;
    font-size: .7rem;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--sl-color-text);
  }
  .sm-nav { flex-wrap: wrap; }
  .sm-nav .sm-release { font-size: .7rem; font-weight: 400; border: 1px solid var(--sm-line); border-radius: .3rem; padding: .3rem .55rem; }
  .sm-nav a { color: var(--sl-color-text); text-decoration: none; font-weight: 600; font-size: .875rem; }
  .sm-nav a:hover { color: var(--sl-color-white); text-decoration: underline; }
  .sm-nav a:focus-visible { outline: 2px solid var(--sm-blue); outline-offset: 4px; }
  @media (max-width: 49.99rem) {
    .sm-header { padding-inline-end: 2.5rem; gap: .5rem; }
    .sm-nav { gap: .65rem; font-size: .875rem; }
    .sm-tools { gap: .25rem; }
    .sm-brand small { display: none; }
  }
  @media (max-width: 30rem) {
    :global(:root) { --sl-nav-height: 8rem; }
    .sm-header { display: grid; grid-template-columns: 1fr auto; gap: .25rem .5rem; }
    .sm-brand { grid-column: 1; grid-row: 1; }
    .sm-brand small { display: inline; }
    .sm-tools { grid-column: 2; grid-row: 1; }
    .sm-nav { grid-column: 1 / -1; grid-row: 2; gap: 1rem; }
  }
</style>
